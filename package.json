{
  "name": "cache-api-local",
  "version": "2.0.0",
  "description": "Tiny, zero-dependency fetch cache with stale-while-revalidate, request dedupe and pluggable storage (memory, filesystem, or your own).",
  "keywords": [
    "api",
    "cache",
    "fetch",
    "http-cache",
    "stale-while-revalidate",
    "swr",
    "dedupe",
    "local-cache"
  ],
  "author": "vinni0786",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VinniWin/cache-api.git"
  },
  "bugs": {
    "url": "https://github.com/VinniWin/cache-api/issues"
  },
  "homepage": "https://github.com/VinniWin/cache-api#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fs": {
      "import": {
        "types": "./dist/fs.d.mts",
        "default": "./dist/fs.mjs"
      },
      "require": {
        "types": "./dist/fs.d.cts",
        "default": "./dist/fs.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.12.7",
    "rollup": "^4.14.3",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
